# Database Configuration
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=your_data
DB_USERNAME=your_username
DB_PASSWORD=<PASSWORD>

# Database Schema Management
# Options: create, create-drop, update, validate, none
# create: Tạo schema mới, xóa dữ liệu cũ
# create-drop: Tạo schema khi start, xóa khi stop
# update: Cập nhật schema, giữ dữ liệu (KHUYÊN DÙNG)
# validate: Chỉ kiểm tra schema, không thay đổi
# none: Không làm gì cả
DB_DDL_AUTO=update
DB_SHOW_SQL=true

# Server Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

# Application
APP_NAME=ck-datveexe-backend

# JWT Configuration
JWT_SECRET=your-secret-key-here-make-it-very-long-and-secure-at-least-256-bits
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_mail
MAIL_PASSWORD=your_pass
MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Logging
LOG_LEVEL=INFO

# Payment Configuration

# MoMo Payment Configuration
PAYMENT_MOMO_PARTNER_CODE=MOMO
PAYMENT_MOMO_ACCESS_KEY=
PAYMENT_MOMO_SECRET_KEY=
PAYMENT_MOMO_REDIRECT_URL=
PAYMENT_MOMO_IPN_URL=
PAYMENT_MOMO_API_ENDPOINT=
PAYMENT_MOMO_REQUEST_TYPE=captureWallet
PAYMENT_MOMO_AUTO_CAPTURE=true
PAYMENT_MOMO_LANG=vi
PAYMENT_MOMO_DEBUG=true

# SePay Payment Configuration
PAYMENT_SEPAY_API_URL=
PAYMENT_SEPAY_ACCOUNT_NUMBER=
PAYMENT_SEPAY_ACCOUNT_NAME=
PAYMENT_SEPAY_BANK_CODE=
PAYMENT_SEPAY_API_KEY=
